#include "sys.h"
#include "usart.h"
#include "pwm.h"
#include "encoder.h"
#include "motor.h"
#include "timer.h"
#include "track.h"
#include "car_control.h"

int main(void)
{
    USART2_Init();
    Track_Init();
    PWM_Init();
    Motor_Init();
    Encoder_Init();
    TIM3_Init();
    delay_init();

    CarControl_Init();

    USART2_SendString("=== Rect Track V6.0 ===\r\n");

    while(1)
    {
        CarControl_Task();
    }
}
